{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env main.ts serve",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env main.ts serve",
    "cli": "deno run --allow-read --allow-write --allow-env main.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "check": "deno fmt --check && deno lint && deno check main.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.7",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ]
    }
  }
}
